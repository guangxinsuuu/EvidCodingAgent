{
  "name": "egap-implementation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "25.4.0",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build": "tsc -b",
    "test": "pnpm build && node --test packages/*/dist/*.test.js apps/control-plane/dist/config.test.js apps/control-plane/dist/server.test.js tools/environment-host/dist/*.test.js apps/review-workbench/dist/*.test.js",
    "test:unit": "pnpm build && node --test packages/*/dist/*.test.js apps/control-plane/dist/config.test.js apps/control-plane/dist/server.test.js apps/review-workbench/dist/auth.test.js apps/review-workbench/dist/importer.test.js",
    "test:integration": "pnpm build && node --test apps/control-plane/dist/lifecycle.test.js",
    "test:lab": "pnpm build && node --test tools/environment-host/dist/*.test.js",
    "egap:lab": "pnpm build && node tools/environment-host/dist/cli.js",
    "dev:control-plane": "pnpm build && node --env-file-if-exists=.env apps/control-plane/dist/main.js",
    "start:control-plane": "node --env-file-if-exists=.env apps/control-plane/dist/main.js",
    "preflight:support": "python3 tools/genai-support-preflight.py",
    "setup:support": "python3 tools/product-boundary/product.py setup",
    "export:support-protocol": "pnpm build && node tools/export-support-schemas.mjs",
    "check:support-protocol": "pnpm build && node tools/export-support-schemas.mjs --check",
    "test:support": "python3 -m unittest discover -s tools/product-boundary -p test_*.py -q",
    "dev:support": "python3 tools/product-boundary/product.py up",
    "support:up": "python3 tools/product-boundary/product.py up",
    "support:status": "python3 tools/product-boundary/product.py status",
    "support:smoke": "python3 tools/product-boundary/product.py smoke",
    "support:stop": "python3 tools/product-boundary/product.py stop",
    "support:start": "python3 tools/product-boundary/product.py start",
    "support:down": "python3 tools/product-boundary/product.py down",
    "verify:runtime": "pnpm build && node packages/verify-runtime/dist/main.js",
    "test:verify": "pnpm build && node --test packages/contracts/dist/verify.test.js packages/contracts/dist/review-*.test.js packages/verify-runtime/dist/*.test.js",
    "test:verify:python": "PYTHONPATH=services/verify-agent/src services/verify-agent/.venv/bin/python -m unittest discover -s services/verify-agent/tests -q",
    "test:registry": "PYTHONPATH=tools/registry:. tools/registry/.venv/bin/python -m unittest discover -s tools/registry -p 'test_*.py' -q && tools/registry/.venv/bin/python -m unittest discover -s tests/catalog -q",
    "verify:calibration": "tools/registry/.venv/bin/python tools/verify-agent-calibration.py",
    "verify:live": "python3 tools/verify-agent-live.py",
    "review:setup": "pnpm build && node apps/review-workbench/dist/setup.js",
    "review:start": "pnpm build && node apps/review-workbench/dist/main.js",
    "review:cli": "node apps/review-workbench/dist/cli.js",
    "review:worker": "pnpm build && node apps/review-workbench/dist/evidence-worker.js",
    "test:review": "pnpm build && node --test apps/review-workbench/dist/*.test.js",
    "setup:support:legacy": "python3 tools/support-service.py setup",
    "test:support:legacy": "pnpm check:support-protocol && python3 -m unittest discover -s tools -p 'test_*support*.py' -v && python3 tools/support-service.py test",
    "dev:support:legacy": "python3 tools/support-service.py start",
    "fixtures:support:legacy": "python3 tools/support-service.py fixtures",
    "support:up:legacy": "pnpm build && services/genai-support-sut/.venv/bin/python tools/support-lab.py up",
    "support:start:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py start",
    "support:status:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py status",
    "support:smoke:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py smoke",
    "support:stop:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py stop",
    "support:down:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py down",
    "test:support:live:legacy": "services/genai-support-sut/.venv/bin/python tools/support-lab.py test",
    "support:build": "python3 tools/product-boundary/product.py build",
    "review:assemble": "tools/registry/.venv/bin/python -m tools.registry.release_assembler"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "7.0.2"
  }
}
