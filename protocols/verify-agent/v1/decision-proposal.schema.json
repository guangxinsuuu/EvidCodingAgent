{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egap:verify-agent:decision-proposal:1",
  "$comment": "模型只提出动作；符合此传输协议不授予执行权限，不证明引用、业务假设或结果为真。Runtime另验候选/决策依据/权限/范围/预算。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "based_on_decision_revision",
    "candidate_epoch",
    "context_view_ref",
    "action_kind",
    "requirement_refs",
    "hypothesis_refs",
    "evidence_refs",
    "expected_information",
    "rationale",
    "hypothesis_updates",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "based_on_decision_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidate_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "context_view_ref": {
      "$ref": "#/$defs/reference"
    },
    "action_kind": {
      "type": "string",
      "enum": [
        "READ",
        "CHECK_INTENT",
        "NOVEL_CHECK",
        "CLARIFY",
        "FINDING",
        "REQUEST_FINAL",
        "STOP"
      ]
    },
    "requirement_refs": {
      "$ref": "#/$defs/references"
    },
    "hypothesis_refs": {
      "$ref": "#/$defs/references"
    },
    "evidence_refs": {
      "$ref": "#/$defs/references"
    },
    "expected_information": {
      "$ref": "#/$defs/text"
    },
    "rationale": {
      "$ref": "#/$defs/text"
    },
    "hypothesis_updates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/reference"
          },
          "statement": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "SUPPORTED",
              "WEAKENED"
            ]
          },
          "evidence_refs": {
            "$ref": "#/$defs/references"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "READ"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "material_ref",
              "start_line",
              "end_line"
            ],
            "properties": {
              "material_ref": {
                "$ref": "#/$defs/reference"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "end_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "CHECK_INTENT"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_ref",
              "scenario_ref",
              "objective",
              "observation_requirements"
            ],
            "properties": {
              "capability_ref": {
                "$ref": "#/$defs/reference"
              },
              "scenario_ref": {
                "$ref": "#/$defs/reference"
              },
              "objective": {
                "$ref": "#/$defs/text"
              },
              "observation_requirements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "NOVEL_CHECK"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "objective",
              "capability_gap"
            ],
            "properties": {
              "objective": {
                "$ref": "#/$defs/text"
              },
              "capability_gap": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "CLARIFY"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "FINDING"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "limitations"
            ],
            "properties": {
              "summary": {
                "$ref": "#/$defs/text"
              },
              "limitations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "REQUEST_FINAL"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "STOP"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  ]
}
